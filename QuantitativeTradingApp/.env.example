# ===== docker-compose 基础设施 =====
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant
POSTGRES_DB=quant

# ===== 后端应用 =====
# 生产必须改为强随机值（openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# 调度（每日流水线，Asia/Shanghai 17:00）
SCHEDULE_ENABLED=true
SCHEDULE_CRON_HOUR=17
SCHEDULE_CRON_MINUTE=0
LOCK_TTL=7200

# 限流 / 安全
RATE_LIMIT_ENABLED=true
TRUST_XFF=true
CORS_ORIGINS=*

# 日志
LOG_LEVEL=INFO
LOG_DIR=/var/log/app

# 直接（非 compose）运行后端时可覆盖的连接配置
# DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
# REDIS_URL=redis://localhost:6379/0
